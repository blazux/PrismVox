# PrismVox — ElevenLabs speech by default; no STT/TTS containers are deployed.
COMPOSE_PROJECT_NAME=prismvox
COMPOSE_FILE=docker-compose.yml

# Published Docker images: unstable follows main; latest follows version tags.
# Set a specific release tag (for example v1.0.0) to pin all three images.
DOCKERHUB_NAMESPACE=blazux
PRISMVOX_TAG=unstable

# Replace these before starting. Generate values with: openssl rand -hex 24
ARI_USER=phoneagent
ARI_PASS=change_me_ari
DB_PASS=change_me_db
UI_USER=admin
UI_PASSWORD=change_me_ui
# Separate Bearer token for /api/agent-chat and /v1/chat/completions.
AGENT_API_KEY=
# Console ports bind to localhost by default. Use a trusted HTTPS proxy remotely.
UI_BIND=127.0.0.1
UI_TLS_SAN=

# SIP trunk / PBX. Values seed the database and trunk on first startup.
# After setup, change the trunk from Configuration → SIP.
SIP_REGISTRAR=sbc.example.com
SIP_REGISTRAR_IP=192.0.2.10
SIP_REGISTRAR_MATCH=192.0.2.10
SIP_DOMAIN=example.com
SIP_USERNAME=phoneagent
SIP_PASSWORD=
SIP_TRANSPORT_MODE=tls
SIP_TLS_PORT=5061
SIP_UDP_PORT=5060
SIP_TLS_VERIFY_SERVER=yes
#SIP_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# OpenAI-compatible language model API root, including /v1.
OPENAI_BASE_URL=http://host.docker.internal:4000/v1
OPENAI_MODEL=your-model-id
OPENAI_API_KEY=
# Standard and outbound model/URL overrides are configured from Agent settings.

# Speech defaults. Save the key, voice and models from Speech providers instead
# if preferred. Database settings override these bootstrap values for new calls.
STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs
# Reuse identical speech across calls (persistent, bounded audio cache).
# Set to off to disable; changing voice/model/pronunciation selects new audio.
TTS_CACHE_DIR=/var/cache/prismvox/tts
# Optional prerecorded WAV: starts after three seconds, finishes before ready response audio.
# Caller interruption or hangup can still stop it.
# WAIT_CUE_WAV=/sounds/tool-hmm.wav
# Optional rotation: directory with clips.json and prerecorded WAVs (up to 2s).
# WAIT_CUE_DIR=/sounds/waiting-cues
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_LANGUAGE=fr
ELEVENLABS_STABILITY=
#ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Optional self-hosted OpenAI-compatible speech APIs, supplied by you.
# STT and TTS can use different providers. No engine is bundled or installed.
#STT_PROVIDER=openai
#STT_URL=http://host.docker.internal:8000/v1
#STT_MODEL=your-transcription-model
#TTS_PROVIDER=openai
#TTS_URL=http://host.docker.internal:8880/v1
#TTS_MODEL=your-speech-model
#TTS_VOICE=your-voice-id
#SPEECH_SERVICE_API_KEY=
# Legacy HTTP services remain available with STT_PROVIDER=service and/or
# TTS_PROVIDER=service: POST /transcribe (audio file), POST /synthesize (text).

# Optional connection to personal or multi-user Prism.
# PRISM_TOKEN is Prism's service token; set VOX_URL and its credentials in Prism too.
#PRISM_URL=http://prism-server:8080
#PRISM_TOKEN=
#PRISM_PUBLIC_URL=https://prism.example.com

# Dictionary bootstrap; subsequently managed from Dictionary in the console.
#WHISPER_HOTWORDS=
#TTS_SPELL_WORDS=
#TTS_SPELL_EXCEPTIONS=OK
#TTS_SPELL_ACRONYMS=true

# Optional external embeddings for the standalone knowledge base.
# Configure URL, model and key in Knowledge Base; saved settings take precedence.
# Ollama and vLLM can serve the same OpenAI-compatible /v1/embeddings API.
#EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#EMBEDDING_MODEL=your-embedding-model-id
#EMBEDDING_API_KEY=

# Audio timing and knowledge retrieval.
#RAG_TOP_K=5
#BARGEIN_MS=2000
LOG_SENSITIVE_DATA=false
DEBUG=false

# Optional NVIDIA language model (not a speech service).
# Append docker-compose.llm-local.yml to COMPOSE_FILE, download the GGUF first,
# then select its URL/model from Agent settings. See README.
#FAST_LLM_MODEL_DIR=./.dev/models/qwen3.5-9b
#FAST_LLM_MODEL_FILE=Qwen3.5-9B-Q8_0.gguf
#FAST_LLM_MODEL_NAME=qwen3.5-9b
#FAST_LLM_PORT=18120
